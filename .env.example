APP_NAME=Coursemy
UPSTREAM_API_BASE=https://courspora.my.id/api
DATABASE_URL=sqlite:///./courspora.db
BLOB_DIR=app/static/blobs
SCHEDULER_ENABLED=true
INITIAL_SYNC_ENABLED=true
REFRESH_COOLDOWN_SECONDS=60
COOKIE_SECURE=false
# Docker Compose also needs POSTGRES_PASSWORD (set a strong password).
# Production: set COOKIE_SECURE=true behind HTTPS.
# Multiple workers: SCHEDULER_ENABLED=false; call the refresh endpoint from cron.
